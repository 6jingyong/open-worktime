{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open Worktime accepted observation",
  "description": "Public observation after intake validation, server receipt metadata, and transparent manufacturing-relevance weighting are attached.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "brand_id",
    "country",
    "work_region",
    "facility_id",
    "facility_text",
    "employment_type",
    "work_role",
    "high_income_5x",
    "weekly_hours_bucket",
    "period_basis",
    "analysis_weight",
    "analysis_flags",
    "submitted_at",
    "source"
  ],
  "properties": {
    "schema_version": { "const": "0.4" },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "Opaque server-assigned report identifier, or a local-only opaque identifier in the prototype."
    },
    "brand_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "country": {
      "type": ["string", "null"],
      "pattern": "^[A-Z]{2}$",
      "description": "Optional coarse work country. Missing geography does not itself reduce manufacturing relevance."
    },
    "work_region": {
      "type": ["string", "null"],
      "maxLength": 80,
      "description": "Optional coarse work region, such as Shanghai, Texas, or Berlin."
    },
    "facility_id": {
      "type": ["string", "null"],
      "maxLength": 200,
      "description": "Canonical Open Worktime facility identifier when the site can be resolved to the facility catalog."
    },
    "facility_text": {
      "type": ["string", "null"],
      "maxLength": 200,
      "description": "Fallback site name supplied by the contributor when no canonical facility is available."
    },
    "employment_type": {
      "type": "string",
      "enum": [
        "direct_contract",
        "labor_dispatch",
        "labor_outsource",
        "onsite_service",
        "other_unknown"
      ]
    },
    "work_role": {
      "type": "string",
      "enum": [
        "manufacturing_frontline",
        "manufacturing_support",
        "management",
        "sales",
        "corporate_function",
        "other_unknown"
      ]
    },
    "high_income_5x": {
      "type": "string",
      "enum": ["no", "yes", "unknown"]
    },
    "weekly_hours_bucket": {
      "type": "string",
      "enum": [
        "lt_35",
        "35_40",
        "40_45",
        "45_50",
        "50_55",
        "55_60",
        "60_65",
        "65_70",
        "70_75",
        "gte_75"
      ],
      "description": "Half-open buckets: 35_40 means 35 <= hours < 40; gte_75 means 75 hours or more."
    },
    "period_basis": {
      "const": "last_4_complete_weeks"
    },
    "analysis_weight": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Server-derived public weight for the default manufacturing-focused analysis. Never supplied by the contributor."
    },
    "analysis_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "manufacturing_frontline",
          "manufacturing_support",
          "management_role",
          "sales_role",
          "corporate_function_role",
          "unknown_role",
          "high_income_5x",
          "known_brand_facility",
          "location_unresolved",
          "location_mismatch_review"
        ]
      },
      "uniqueItems": true,
      "description": "Public reasons that explain the analysis weight."
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "enum": ["local_prototype", "community_report", "imported_with_permission"]
    }
  }
}
